[ req ]
default_bits = 2048
prompt = no
encrypt_key = no
default_md = sha1
distinguished_name = dn
req_extensions = cert_ext

[ dn ]
CN = Fake Salt Edge TPP
O  = Fake Salt Edge TPP
C  = MD
ST = Fake TestTest Street

[ cert_ext ]
basicConstraints     = CA:TRUE
subjectKeyIdentifier = hash
keyUsage             = critical,digitalSignature,keyEncipherment
extendedKeyUsage     = clientAuth,serverAuth
qcStatements         = "ASN1:UTF8String:...statement F..."
subjectAltName       = "email:artiom.teleshman+123@saltedge.com"
